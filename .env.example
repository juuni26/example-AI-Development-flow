# Copy this file to .env. The .env is gitignored — never commit secrets.
#
# For local development the defaults below work as-is. For production deploys
# OVERRIDE every value marked DEV_DEFAULT: the env validator refuses to boot
# with a known-default JWT_SECRET when NODE_ENV=production.

# --- Database ------------------------------------------------------------
POSTGRES_USER=cleandrop
POSTGRES_PASSWORD=cleandrop                 # DEV_DEFAULT — override in prod
POSTGRES_DB=cleandrop
DATABASE_URL=postgres://cleandrop:cleandrop@db:5432/cleandrop

# --- Host-side port mappings --------------------------------------------
# Override if the defaults clash with other services on your machine.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=3000
WEB_HOST_PORT=8080

# --- API ----------------------------------------------------------------
NODE_ENV=development
JWT_SECRET=change-me-in-production-this-is-a-dev-secret-not-for-real-use  # DEV_DEFAULT
ACCESS_TOKEN_TTL=15m

# Comma-separated allowlist of browser origins that the API will accept
# cross-origin requests from. Default works for the bundled web app on
# both 8080 (Docker) and 5173 (vite dev).
WEB_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Web (build-time, baked into the bundle) ----------------------------
# Must match API_HOST_PORT. After changing this, rebuild the web image:
#   docker compose build web
VITE_API_URL=http://localhost:3000
