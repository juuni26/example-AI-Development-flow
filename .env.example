# Copy this file to .env. The .env is gitignored — never commit secrets.
#
# For local development the defaults below work as-is when running everything
# via `docker compose up`. For host-side dev (`bun run dev` with hot reload),
# create a .env.local with the overrides shown at the bottom of this file.
# .env.local is gitignored and takes precedence over .env.

# --- Database ------------------------------------------------------------
POSTGRES_USER=cleandrop
POSTGRES_PASSWORD=cleandrop                 # DEV_DEFAULT — override in prod
POSTGRES_DB=cleandrop
# This URL uses the docker compose hostname "db" — works inside the network
# but NOT from the host. For `bun run dev` (host-side), override DATABASE_URL
# in .env.local to use localhost:${POSTGRES_HOST_PORT}.
DATABASE_URL=postgres://cleandrop:cleandrop@db:5432/cleandrop

# --- Host-side port mappings --------------------------------------------
# Override if the defaults clash with other services on your machine.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=3000
WEB_HOST_PORT=8080

# --- API ----------------------------------------------------------------
NODE_ENV=development
JWT_SECRET=change-me-in-production-this-is-a-dev-secret-not-for-real-use  # DEV_DEFAULT
ACCESS_TOKEN_TTL=15m
# Refresh-token lifetime. Accepted suffixes: s, m, h, d. Default is 7d (1 week).
REFRESH_TOKEN_TTL=7d

# Comma-separated allowlist of browser origins that the API accepts CORS
# requests from. Includes both the docker-built bundle (:8080) and the
# Vite dev server (:5173) for host-side dev.
WEB_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Web (build-time, baked into the bundle) ----------------------------
# Must match API_HOST_PORT. After changing this, rebuild the web image:
#   docker compose build web
VITE_API_URL=http://localhost:3000

# ========================================================================
# For host-side dev (`bun run dev`), create .env.local with these overrides:
# ------------------------------------------------------------------------
# # Host-side DB URL — uses the published port, not the compose network
# DATABASE_URL=postgres://cleandrop:cleandrop@localhost:5433/cleandrop
# ========================================================================
