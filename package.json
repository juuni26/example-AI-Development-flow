{
  "name": "cleandrop",
  "private": true,
  "version": "0.1.0",
  "description": "Services catalog — Cleandrop fullstack take-home",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,magenta \"bun --filter @cleandrop/api dev\" \"bun --filter @cleandrop/web dev\"",
    "dev:api": "bun --filter @cleandrop/api dev",
    "dev:web": "bun --filter @cleandrop/web dev",
    "dev:db": "docker compose up -d db",
    "dev:setup": "docker compose up -d db && bun --filter @cleandrop/api db:migrate && bun --filter @cleandrop/api db:seed",
    "build": "bun --filter '*' build",
    "test:api": "bun --filter @cleandrop/api test",
    "test:e2e:api": "bun --filter @cleandrop/api test:e2e",
    "test:e2e:web": "bun --filter @cleandrop/web test:e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "9.0.1",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.60.0"
  }
}
